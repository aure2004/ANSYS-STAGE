# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS 3")
results1 = system1.GetContainer(ComponentName="Results")
results1.Edit()
model1 = system1.GetContainer(ComponentName="Model")
model1.Exit()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsSpaceClaimGeometry=True)
geometry1.Exit()
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1.Edit()
model1.Exit()
geometry1.Edit(IsSpaceClaimGeometry=True)
geometry1.Exit()
model1.Edit()
model1.Exit()
system1.DisplayText = "3couches"
system2 = GetSystem(Name="SYS 1")
results2 = system2.GetContainer(ComponentName="Results")
results2.Edit()
model2 = system2.GetContainer(ComponentName="Model")
model2.Exit()
system2.Delete()
system3 = GetSystem(Name="SYS 2")
results3 = system3.GetContainer(ComponentName="Results")
results3.Edit()
model3 = system3.GetContainer(ComponentName="Model")
model3.Exit()
system3.DisplayText = "Refroidissement plaque 40x10x0.2"
template1 = GetTemplate(
    TemplateName="Transient Thermal",
    Solver="ANSYS")
engineeringDataComponent1 = system1.GetComponent(Name="Engineering Data")
geometryComponent1 = system1.GetComponent(Name="Geometry")
system4 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent1, geometryComponent1, modelComponent1],
    Position="Right",
    RelativeTo=system1)
modelComponent2 = system4.GetComponent(Name="Model")
modelComponent2.Refresh()
setupComponent1 = system4.GetComponent(Name="Setup")
setupComponent1.Refresh()
setup1 = system4.GetContainer(ComponentName="Setup")
setup1.Edit()
model1.Exit()
system4.Delete()
solutionComponent1 = system1.GetComponent(Name="Solution")
componentTemplate1 = GetComponentTemplate(Name="SimulationSetupCellTemplate_ThermalTransientANSYS")
system5 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent1, geometryComponent1, modelComponent1],
    DataTransferFrom=[Set(FromComponent=solutionComponent1, TransferName=None, ToComponentTemplate=componentTemplate1)],
    Position="Right",
    RelativeTo=system1)
modelComponent3 = system5.GetComponent(Name="Model")
modelComponent3.Refresh()
setupComponent2 = system5.GetComponent(Name="Setup")
setupComponent2.Refresh()
setup2 = system5.GetContainer(ComponentName="Setup")
setup2.Edit()
model1.Exit()
Save(Overwrite=True)
