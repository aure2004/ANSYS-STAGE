# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS 7")
system1.DisplayText = "10COUCHES_ETUDIANT"
system2 = GetSystem(Name="SYS 8")
system2.DisplayText = "10COUCHES_COMPLET"
model1 = system2.GetContainer(ComponentName="Model")
model1.Edit()
model1.Exit()
model2 = system1.GetContainer(ComponentName="Model")
model2.Edit()
model2.Exit()
model1.Edit()
model1.Exit()
setup1 = system1.GetContainer(ComponentName="Setup")
setup1.Edit()
model2.Exit()
model1.Edit()
model1.Exit()
model2.Edit()
model2.Exit()
system1.Copy(KeepConnections=True)
system3 = GetSystem(Name="SYS 9")
model3 = system3.GetContainer(ComponentName="Model")
model3.Edit()
model3.Exit()
Save(Overwrite=True)
results1 = system3.GetContainer(ComponentName="Results")
results1.Edit()
model3.Exit()
model1.Edit()
model1.Exit()
system1.Copy(KeepConnections=True)
system4 = GetSystem(Name="SYS 10")
geometry1 = system4.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsSpaceClaimGeometry=True)
geometry1.Exit()
modelComponent1 = system4.GetComponent(Name="Model")
modelComponent1.Refresh()
model4 = system4.GetContainer(ComponentName="Model")
model4.Edit()
model4.Exit()
geometry1.Edit(IsSpaceClaimGeometry=True)
geometry1.Exit()
geometryComponent1 = system4.GetComponent(Name="Geometry")
geometryComponent1.Reset()
geometry1.Edit(IsDiscoveryGeometry=True)
geometry1.Exit()
geometry1.Edit(IsSpaceClaimGeometry=True)
geometry1.Exit()
system4.Delete()
system3.Copy(KeepConnections=True)
system5 = GetSystem(Name="SYS 10")
system5.DisplayText = "10 COUCHES 40x0.2x0.2"
geometryComponent2 = system5.GetComponent(Name="Geometry")
geometryComponent2.Reset()
geometry2 = system5.GetContainer(ComponentName="Geometry")
geometry2.Edit(IsSpaceClaimGeometry=True)
geometry2.Exit()
modelComponent2 = system5.GetComponent(Name="Model")
modelComponent2.Refresh()
model5 = system5.GetContainer(ComponentName="Model")
model5.Edit()
model5.Exit()
geometry2.Edit(IsSpaceClaimGeometry=True)
geometry2.Exit()
modelComponent2.Refresh()
model5.Edit()
model5.Exit()
Save(Overwrite=True)
