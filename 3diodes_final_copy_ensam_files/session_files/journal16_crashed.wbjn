# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS 6")
results1 = system1.GetContainer(ComponentName="Results")
results1.Edit()
model1 = system1.GetContainer(ComponentName="Model")
model1.Exit()
system1.DisplayText = "1filament_3"
system1.DisplayText = "3_un filament"
template1 = GetTemplate(
    TemplateName="Transient Thermal",
    Solver="ANSYS")
system2 = GetSystem(Name="SYS 3")
engineeringDataComponent1 = system2.GetComponent(Name="Engineering Data")
system3 = GetSystem(Name="SYS 5")
system4 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent1],
    Position="Below",
    RelativeTo=system3)
system4.DisplayText = "3_40x10x0.2"
geometry1 = system4.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsSpaceClaimGeometry=True)
geometry1.Exit()
modelComponent1 = system4.GetComponent(Name="Model")
modelComponent1.Refresh()
model2 = system4.GetContainer(ComponentName="Model")
model2.Edit()
model2.Exit()
system4.DisplayText = "3_40x10x0.2_nonvalide"
system1.Delete()
engineeringDataComponent2 = system3.GetComponent(Name="Engineering Data")
system5 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent2],
    Position="Right",
    RelativeTo=system3)
geometry2 = system3.GetContainer(ComponentName="Geometry")
geometry2.Edit(IsSpaceClaimGeometry=True)
geometry2.Exit()
geometry3 = system5.GetContainer(ComponentName="Geometry")
geometry3.Edit(IsSpaceClaimGeometry=True)
