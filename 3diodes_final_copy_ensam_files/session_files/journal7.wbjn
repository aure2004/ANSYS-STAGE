# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
system1 = GetSystem(Name="SYS")
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
model1.Exit()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit(IsSpaceClaimGeometry=True)
geometry1.Exit()
modelComponent1 = system1.GetComponent(Name="Model")
modelComponent1.Refresh()
model1.Edit()
model1.Exit()
geometryComponent1 = system1.GetComponent(Name="Geometry")
geometryComponent1.Reset()
geometry1.Edit(IsDiscoveryGeometry=True)
geometry1.Edit(IsSpaceClaimGeometry=True)
geometry1.Exit()
modelComponent1.Reset()
modelComponent1.Refresh()
model1.Edit()
model1.Exit()
template1 = GetTemplate(
    TemplateName="Transient Thermal",
    Solver="ANSYS")
engineeringDataComponent1 = system1.GetComponent(Name="Engineering Data")
system2 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent1],
    Position="Right",
    RelativeTo=system1)
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.Edit(IsSpaceClaimGeometry=True)
geometry2.Exit()
modelComponent2 = system2.GetComponent(Name="Model")
modelComponent2.Refresh()
model2 = system2.GetContainer(ComponentName="Model")
model2.Edit()
model2.Exit()
engineeringDataComponent2 = system2.GetComponent(Name="Engineering Data")
system3 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent2],
    Position="Right",
    RelativeTo=system2)
Save(Overwrite=True)
geometry3 = system3.GetContainer(ComponentName="Geometry")
geometry3.Edit(IsSpaceClaimGeometry=True)
geometry3.Exit()
modelComponent3 = system3.GetComponent(Name="Model")
modelComponent3.Refresh()
model3 = system3.GetContainer(ComponentName="Model")
model3.Edit()
model3.Exit()
geometry1.Edit(IsSpaceClaimGeometry=True)
engineeringDataComponent3 = system3.GetComponent(Name="Engineering Data")
system4 = template1.CreateSystem(
    ComponentsToShare=[engineeringDataComponent3],
    Position="Right",
    RelativeTo=system3)
geometry1.Exit()
geometry4 = system4.GetContainer(ComponentName="Geometry")
geometry4.Edit(IsSpaceClaimGeometry=True)
geometry4.Exit()
modelComponent4 = system4.GetComponent(Name="Model")
modelComponent4.Refresh()
model4 = system4.GetContainer(ComponentName="Model")
model4.Edit()
model4.Exit()
geometry4.Edit(IsSpaceClaimGeometry=True)
geometry4.Exit()
modelComponent4.Refresh()
model4.Edit()
model4.Exit()
Save(Overwrite=True)
